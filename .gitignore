project/data/enterprise-attack-18.1.json
project/data_v2/external_*/

# Generated experiment artifacts
project/logs/
project/**/checkpoints/
project/**/results/
project/**/outputs/

# Binary reports are local deliverables; Markdown sources remain versioned
*.docx
*.pdf
