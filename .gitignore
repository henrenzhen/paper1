# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.uv-cache/

# IDE and notebook state
.idea/
.vscode/
.ipynb_checkpoints/

# Secrets and local configuration
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Logs and temporary files
*.log
tmp/
~$*

# Model weights and serialized training state
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.joblib

# Generated datasets and per-sample outputs
*.csv
*.jsonl
*.parquet
*.feather

# Versioned research datasets and CoT caches
!project/data/*.csv
!project/data_v2/core/*.csv
!project/data_v2/micro_state/*.csv
!project/data_v2/repro_external/
!project/data_v2/repro_external/**
!project/data_v4/external_reasoning/
!project/data_v4/external_reasoning/**

